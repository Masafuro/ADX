/*
 * ADX Core V0: RS-485 Hot Test (Setup 2) Sketch
 * Target: ATtiny1616 (via megaTinyCore)
 */

void setup() {
  // --------------------------------------------------------
  // 1. GPIOの初期化 (The Noticeable System / 斑の排除)
  // --------------------------------------------------------
  // megaTinyCoreのピン番号マクロに依存せず、AVRのレジスタを直接操作して
  // 物理的な真実(Real)に基づき確実にピンを設定します。
  
  // PA4(DE), PA3(RE), PA1(TXD) を出力(OUTPUT)に設定
  PORTA.DIRSET = PIN4_bm | PIN3_bm | PIN1_bm; 

  // PA4(DE) = HIGH (送信ドライバ有効)
  // PA3(RE) = HIGH (受信レシーバ無効)
  PORTA.OUTSET = PIN4_bm | PIN3_bm; 


  // --------------------------------------------------------
  // 2. PORTMUX (ピン多重化) の設定
  // --------------------------------------------------------
  // USART0のTXD/RXDをデフォルトのPB2/PB3から、代替ピンであるPA1/PA2へ切り替えます。
  // このレジスタ操作を行うことで、後のSerial.begin()が自動的にPA1/PA2で機能します。
  PORTMUX.CTRLB |= PORTMUX_USART0_bm;


  // --------------------------------------------------------
  // 3. USARTの初期化 (Grace)
  // --------------------------------------------------------
  // クロックやボーレートの複雑な計算はArduinoのコア機能に委ねます。
  // Analog Discovery 3で観測しやすい 9600 bps に設定します。
  Serial.begin(9600);
}

void loop() {
  // --------------------------------------------------------
  // 4. テストパターンの送信
  // --------------------------------------------------------
  // 0x55 は2進数で '01010101'。
  // オシロスコープで波形の立ち上がり・立ち下がり(スルーレート)を
  // 最も客観的に観測しやすい究極のテストパターンです。
  Serial.write(0x55);

  // 連続送信によるオシロスコープのトリガー混乱を防ぐため、
  // 10msのディレイ(無音区間)を挟んで波形を際立たせます。
  delay(10);
}
