
/*
 * ==============================================================================
 * ADX Core V0: RS-485 Hot Test (Setup 2) Sketch
 * Target: ATtiny1616 (via megaTinyCore)
 * ==============================================================================
 * 
 * [AD3 Connection / AD3の結線]
 * ※ AD3の電源出力は事前にOFFにして結線すること（無理の排除）。
 * ※ GNDは1つのターミナルへの集中によるショートや接触不良（無理・斑）を防ぐため、
 *    等電位であるCN1のGND_5Vピンに分散して接続する（The Noticeable System）。
 * 
 * - 電源 (Power): 
 *   AD3 V+ (赤)           -> CN12 Pin 3 (VIN_7V_48V)  ※ 5.0Vに設定
 *   AD3 GND (黒)          -> CN12 Pin 4 (GND_IN)      ※ 電源リターン用
 * 
 * - オシロスコープ CH1 (RS-485 Aライン観測):
 *   AD3 1+ (オレンジ)     -> CN12 Pin 2 (RS-485_A)
 *   AD3 1- (オレンジ/白)  -> CN1 Pin 2 (GND_5V)       ※ 電圧基準用（分散接続）
 * 
 * - オシロスコープ CH2 (RS-485 Bライン観測):
 *   AD3 2+ (青)           -> CN12 Pin 1 (RS-485_B)
 *   AD3 2- (青/白)        -> CN1 Pin 4 (GND_5V)       ※ 電圧基準用（分散接続）
 * 
 * ------------------------------------------------------------------------------
 * [Judgment / 結果の判定方法 (The Noticeable System)]
 * WaveFormsのScope計器でCH1とCH2を有効にし、Math機能で「C1 - C2」を表示する。
 * 
 * 🟢 正常の指標 (Grace):
 *   1. CH1(A)とCH2(B)が、互いに完全に反転した矩形波を出力していること。
 *   2. 送信データ 0x55 (01010101) に対応した波形が約10ms間隔でバースト出力されること。
 *   3. Math (A - Bの差動電圧) の振幅が、無負荷時に十分な電圧（仕様上、VCC=5V・54Ω負荷時で
 *      Typ 3.3V、無負荷時はそれ以上）を確保できていること。
 * 
 * 🚨 異常の指標 (Real / The Bravery of Suspention):
 *   - CH1とCH2の波形が反転していない、あるいは一方が全く変化しない。
 *   - 波形の立ち上がり/立ち下がり（スルーレート）が極端に鈍っている。
 *   - 電流値が100mA以上の大電流を示している。
 *   => このような違和感に気づいたら、直ちにAD3の電源出力をOFFにし、真因(Root)を追求すること。
 * ==============================================================================
 */

void setup() {
  // --------------------------------------------------------
  // 1. GPIOの初期化 (The Noticeable System / 斑の排除)
  // --------------------------------------------------------
  // megaTinyCoreのピン番号マクロに依存せず、AVRのレジスタを直接操作して
  // 物理的な真実(Real)に基づき確実にピンを設定します。
  
  // PA4(DE), PA3(RE), PA1(TXD) を出力(OUTPUT)に設定
  PORTA.DIRSET = PIN4_bm | PIN3_bm | PIN1_bm; 

  // PA4(DE) = HIGH (送信ドライバ有効)
  // PA3(RE) = HIGH (受信レシーバ無効)
  PORTA.OUTSET = PIN4_bm | PIN3_bm; 

  // --------------------------------------------------------
  // 2. PORTMUX (ピン多重化) の設定
  // --------------------------------------------------------
  // USART0の通信ピンを代替ピンである PA1(TXD) / PA2(RXD) へ切り替える
  PORTMUX.CTRLB |= PORTMUX_USART0_bm;

  // --------------------------------------------------------
  // 3. USARTの初期化 (Grace)
  // --------------------------------------------------------
  // Analog Discovery 3で観測しやすく、THVD2410 (最大500kbps) に
  // 無理のない 9600 bps で通信を初期化する
  Serial.begin(9600);
}

void loop() {
  // --------------------------------------------------------
  // 4. テストパターンの送信
  // --------------------------------------------------------
  // 0x55 ('U') = 01010101 (2進数)
  // High/Lowが交互に繰り返されるため、波形の健全性確認に最適。
  Serial.write(0x55);

  // 連続送信によるオシロスコープのトリガー混乱を防ぐため、
  // 10msの無音区間(ディレイ)を挟んで波形を際立たせる。
  delay(10);
}
